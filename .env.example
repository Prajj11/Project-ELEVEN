# Node Environment
NODE_ENV=development
PORT=3001

# CORS Configuration
CLIENT_ORIGIN=http://localhost:5173

# Frontend (Public URL)
VITE_SERVER_URL=http://localhost:3001

# LLM Provider Configuration (Server-Only, never expose to client)
# Options: gemini | openai | fallback
LLM_PROVIDER=fallback
LLM_API_KEY=
LLM_MODEL=gemini-1.5-flash
LLM_TIMEOUT_MS=5000
LLM_MAX_REQUESTS_PER_MATCH=20
